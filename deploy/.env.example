# Copy to `.env` in this directory (gitignored); compose feeds it to the runner
# service only. Every variable is read by name and reported by name when a job
# needs it and it is missing.
#
# ENGINE_ALLOW_OUTBOUND is deliberately NOT here: the compose file sets it
# inside the runner container, and nowhere else ever should (ADR 0018).

# Cloudflare R2 — the bucket the tilesets publish to.
ENGINE_R2_ACCESS_KEY_ID=
ENGINE_R2_SECRET_ACCESS_KEY=
ENGINE_R2_ACCOUNT_ID=
ENGINE_R2_BUCKET=
# Custom endpoint and public domain, when they differ from the defaults
# (https://<account>.r2.cloudflarestorage.com and tiles.streetradar.app).
#ENGINE_R2_ENDPOINT=
#ENGINE_R2_PUBLIC_DOMAIN=

# Discord webhook for operational alerts (run published, run failed, crash).
# Leave empty to run without alerting.
ENGINE_DISCORD_WEBHOOK=

# Apple's maps token — only needed once the Apple job is wired.
#ENGINE_APPLE_TOKEN=
